            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZiy7KHYcELxW0-xK2Znc6-jhd86CFx24ABF8OR9L6kotJTAY-0YWTnvHVC7gMCz_64fgUnTVDnjXjLi95YQgAZMq_K1pZ1AG4eoCRCqL6Jq6nD4t6d9DbmkWTYFUVaotXn73rcO53toIUvN77IYfKmVfNzB6d3HgMiA38KoqPt7tYWQ7IA6t1N6bDbQKTnQHniGFYj9zb0JtA?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZjOUXgo2lDynbkwuiJLc6kcJwzDmvtID28JLDhQSA5cWni2dj_fFH13t5Rt5w9utur9Aa3VqX1wGyfAKMyumQlMzyzoTzCyRIhjZn8koOmWazXQ9GEgVDxM1BwEFEvI8JvKNeyNdXVMAetcwcn7bfi4OaGCtia3auOEO6jdKlNf4lmmS9hZrZJf89koCKybVdHlrxiwJWsYhQ?authuser=0&fife=s16383]]></value>
