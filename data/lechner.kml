            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZhCpiVPodnbhCJvPhG2Ce7A6o8px9Mc05yGaR8ojepUjlbOXSoIc5VfyApAyYwtb5qZh6ZM1RmLoZJ2CG4uKluA3KyA5NlpbALjtZImsjUiJSkDYlKxASGakJG5JlKRc13Ht1rbI8hyXYr-xAN3rf6Wbht_YpoteE9fycRv-h4IEoAGmToypnx6Fc8lYZDdIAJzOjOMGjiUdA?authuser=0&fife=s16383]]></value>
