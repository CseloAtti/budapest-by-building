            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZjWh_eh_6U9JH6rQaqT4tbdgUPlKcMe6RqRf6Kv7ogl-rGTvrjjbYMWmAyAsXW_pqbvF-mma8io3w2OTike6QadfsPTqiZmb9v6sHgqgdHOPrplqFfXT-eYl8Qwb93o1D8CX4r7q3DXiVypGuPvnK75AwG2-qFP7DH8HG2LPtRnvM0WxYeahHPvW6-bZ5tDevqtXCcXwxEPng?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZgYE2Hpn4RcbJjMfyPm6GKGeYmnUbVEvJHtCfRad4-MU8UGGbjb0GAvZssxsIXIIMOJWTqo8Ge9Kgkv3UGs050Elg8W-p61FzUDP76AtE8dNqNwjdIvV2eKuvgAlpkC4zFV6kcGyrP25TdfE0z-7zv8LkmPGHKGMbM6P7Ij7qPLDAvpvZZMptv5bEtp-dm1Tti5Bw6v0WAj6Q?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZjw04zB6eDop5C8UZTdTQGx1G7zliRrji4sQ1YeYgiqlZD0VeIif6persQ1v6B8BomYqQN5pj5B_ZwSEJqFiZ9lHN8PK1yNi76EPesTC4JViPTuLojAfmJLz6gW_veNapNxqUmikCas0rOlPwaVEcIrh93gKkyPo9vSdGFB5s13RcnL__bwv2WIHAXeowiOtGkvH4w-s5BmdzE?authuser=0&fife=s16383]]></value>
