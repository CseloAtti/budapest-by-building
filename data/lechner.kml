            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZj0SMJRcPsMVm1x-Bx-dI583tjZG7-qDud_-TomVZtCi0sQXYihke7xzO1zXYeOZFg2he75nIcNYJ8rMIPCFmauXOiSeDczxmMnIxiXCh4tVIWMxHuU98vK_kxL4Zq7MuupgGt2BdTyBIanDrUis27TMdaBug7i6UBxP8jHtUM3Ci2-0EqBpuT6n3yGSS1RSokSzBTEZYdNiBY?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZjU6gp0MVMXqTmxRmWeTaWeKtx-U0cSiuqLblOIOpWCDfk63FlUC8JABpfDCL5P_G4DcP1MEBXzybpr-4KvXejiz9nTdSt0Gpw_ni9Az9hUb3EtkdGJAkcXcbIF9esyhIg0mQpvW-KH2Ij_jHjFtYvKri2IUOo3F7T1uk-TSiOUuCHIV_Moup1rkOvRNTICBU7yUvbn5zdsZA?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZgUxqe26WN5dRr7CWeFb2GCBlRzN5qZwXQ1b3U7dhh7UzIYdNm9eT4Y2-1ymEjJ2292qCcv898Cy0vuJ6wi8JgXfhoszGlmfYXG3jppmweTpajKt4l3aSgGoMkqfQcuqzy5t8w_YYEea8WRU4r3ZMvCiF-l8X9eiw8tLtN4_j9WEohB51RBiWt-0eWFuJRH0pUCJYfDbUaHUQ?authuser=0&fife=s16383]]></value>
