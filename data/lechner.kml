            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZgI6P9tAFRLXeofPJBT8_lziPj7Hd7CfKEKu6RmU2e7nnaffyUTSUSPVo5TZjN0DJQQi9tEMaqcRo_cx3n0lXQDGO9dGmyLW7CqObD7MxvwRpcF29Mwkc38JH27E2SuoDiEwU3rYzKwxRKrfeICdkDnVQ0onRMcHrh-7rG0I7-IRlhpQ6A_HbKJlc1vnEiDhXa7hZ0a0CWUcQ?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZiWELZI8m_a1eCQDHAcZ_Au0shJOnTipap-DLgHO-_QgZrJPbfrHq2VBdnEi7i3bqKBd7JjbklmbdmX5Hs926PJneRnPSz6XxUmtdWKa-VAj1E0wxnZ0JzF9ET8rBOG73Xq6XzV7gUcHNn2l_IOp1REcSEO253JgXRjhkebz0bdz7SyxzhPDr9wIrDLK0a45Je0oNIlkZAsPw?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZj6CNO-XgaBrKynihOC6uF5UovRVl6biz9WKHb6U-mGDt5q4uzBRjZeFCSOWnc5ROeY-HhFaEhzkRLXHbzJsUUsyigjljkpqZtD3ZuAL7b5PaMzAbVV5smFM0GyzbMYYusgNeHND4K8ekHBg4t5r1fKJjAkppyy3tfP-n1_k0MrO_Juk8mGkLVAymZB0wBb7qc6jbD9XYAo9w?authuser=0&fife=s16383]]></value>
