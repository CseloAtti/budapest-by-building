            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZgFo8LvnwUOMe3p7tsSynqFkArusgDWzPBiAD1EKd_lFcCkbbh1cqs_JOBGrlciggakkPdsCRPNuZrwf49yLE_nq97W-NqB1DY6N6YRWvB1T-8MXm_dod8BkvoZuU1D_3PRNVcHrKu34JhAh681CdV8CKgS08IwXs1udNKiov8w6DhZBTnDaSaaP6Y--EEkAOkgNRtKTAq1Nw?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZjNPpfYxcVwEHbBPPcBtHhKoLJb7yqktkfBW6HuwXrHO4vwgVfLFkD25SCGS2nMx_n9flklqrDX3J3y5BZA-ymrqAtVaQA8PcfRgxV0bLX8gf5RkWrrPBVd0fU1ymzpQ7CPc1EaRU8xtWB5mm2cpl1VsAjqMpomOwb9UydCMsrLCRNbnHRqgrFFA1BM-NDWUXILZB60daUmLQ?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZiufRM94anxQv8h33RsyS9syBY0l49HufzznN0v3pst8roTkrqA0n2ndjjZ3ePuMgEq76lttGS3FJbhds1JP-pMyCBqG2zIoS3yiIV3Wb4O7VheirNULNVRf0hfDa8hH5V_EzmTRlS1H8lCNPrNP80bnAdDawfV1ykoWOFw8sYz0GOf4t8MMjBi4zYEwhYEb2xboWPh2xu2_Q?authuser=0&fife=s16383]]></value>
