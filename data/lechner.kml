            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZjHq0B-rG0_Bl3CYg8mlnMKE2RBNpt-npqpa7P2FJhOi5Yra6wtonIw4uY7Crz8JZcMoqHm-ZATkDOvn9C9qryjhTJzxXGlKJqN1W-wUhPuI7mbZVQIt3XcQlbRC0_D3LvTX1UdkTr-VRDzP7Op6dcTl2RhqhFfO9VH5UWeOZnLLjeo3bGVDF5fMQu979RG68JJPr53hJxBgA?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZivhjJhqxvMKEKJXzopJtEg10Ii85ruMWNosCriyv1SoGHaEWSoYS_Zhg0T_jfJBh5ojJ2Hd-64lkXZB2lWII-HPdVGJxWLtjkAxPTMNRvTmY2t7ylsconT_NLWTTCB-3EEHZEHdPL4PPmQTRqjSXI1xvkNMRV8o530a4qgXLXa-fb2EnCh0EoqZT9ZbC2D58r3i0B229FCVg?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZj98ZJiUNGyEAGk9iXnsLbXoOHKzllpky-KdTbFt7T7ioiTjEX7nU_M0m-qGavW7sNFdEcG3HsiO4vBcpIZlINi3PbhKBv0Qx0X-88Jqm9r5Y0wgz_Jx2MKCxaLQs5_1jEiddroJtP2mygC4vrgE5onuO_DybNIiB0KvPp7UCSrOPs7mVyJ1dzbbU0SLp-S93sR2qqrfKoHjA?authuser=0&fife=s16383]]></value>
