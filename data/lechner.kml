            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZhTdsQIflJY_yD1m2bFu5v5Huih3AM9EqKULKhU43ktH6hxiEg-xcKlQC4GGd07RYEF70d5ehG5BPlE4KqIRweJJLjgjlR8FDHqTQiREcjqkL3KQd17zRXbyrZcpJBHsm6R5jvvssyEyctqnnVWVlMgWq-PLuKRsW18KHwrmddsaSOQsN8f94DEI6nqYFJWemfQ1-LYLlLv-g?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZiKbpokraTh1ldn7_htDE39ele_WCZ_5MN8nSlgeySTChDS7fMVixy6KhX2vHyicNQrJk4SHg9WoDfaXVz9wZFp6pnCQRng_d3UOqzcA5ginDVLNOS6BzmbuhhjU7z_ZtB-MagyW323HMOMlUBPabU3Ys39V9MY_HJjaXA9Ig7hx8B0WzrrY5q9azHNDA8iA1rgltL78HAh-Q?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZh6Y5R1qCvi2qgbGYUcb4lZ77dKgEML4fQVxHRWvC-pJaKIIGVjTwR5K0TSEJxLiCPh0WfsFuX0Js46o5ZFfm3YlKS1kx1NxtRE3MWVXtMsa_s06sORdb11whIBUEYFWf8eT9cXTYeIzY9ZOjBrzEL0R_VXpt-woZ-mUuMcNDcTik877YCJTZewDVvlmDQTCl37xOqZ2JaQMw?authuser=0&fife=s16383]]></value>
