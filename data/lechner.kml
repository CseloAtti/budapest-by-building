            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZju7QDTWzs91li2UwTyZyNXg7aDhFXPvu9gUiGGOYnqAImNrbPup_O_vdPMg1WtGdMaiDsDmZ26HowgRceRdKpjIwnVg6TvSJ4ErvZFKn4eANQZf9S5FQl-l-d_zM6C1m8sak_pPhXgAgqQtBgZ5cV7dI2hKu_Zh_tioLT0vplI_4DdyQvKonwQaBuO92qx0HUT2zp_f-RvDdo?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZg50JynbU7JSOy-TPakafDbdy6tmmqpVITo_WH5oy8DJt0ONaCn_ig4pM6uHLK-zoW_UkEETqwf02rdJGDcLqmqjXJYpPZX2O9QpEZnXvFAaJiAn3gtgHhNs8QGyzuiMHZBAolelyhFovf36paoX9kl30VeIzOLL1Wv7YyA_IaqMhy9BNIivAj2BM5RNJg2_N0noumkeNDXnwA?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZhjuhm9_uC8jpL5CY1jR9wrSRy41k0CpqNLrkIwbv7JZxTmvdZvRri__dOfS3jFKrj5O30IZLNupvcW4d-wGhIB-X6QSon9PAGWsKi1wtRwG4L0zty9YOGGbhvmhnLd7pH9Xw4ywg2-_Kc6ExGS6Ic_PGsOwcYv5VGc4zajVigePd-Z3m61aBK85TfBVoAVqSpqnBF5cuRODb8?authuser=0&fife=s16383]]></value>
