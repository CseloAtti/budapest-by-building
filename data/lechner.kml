            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZhOpvSq7xZ_MRQWpw1cDAIwoZazbDPrb25Imn4r6wQpupfJMy2qgIAepXe7KgYXGFKZRWm9uUOBMiwbHLvVN8pqW0fIFT-HQfZ_hsjw7NKVAn_ZaXFBEOliYXWVVI-CdFdQ9VfePHWzTtqakBquLUNEa-V9H5NZdNXY4Qk1fozbGOdXqUvPrBU3M9ciWLjvLh4MYsj1CeE8Hf0?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZigqw1BP0Hn3FCIqwHshmOwmGyVdO2iak05M7KCFeum7JdeVXW9bg_Uo29zgKU_9gJNzeArKRqehmtAV5d369ZlKm2liRRykXKClxnEo97asSL7xKPSFssGNHgr6wuh2PXsbyFn_N-6nRmCMseupK4nNyHiKcfstpRP79lZdQBzbXjI_HI6KdbuyQTQZjYcBJw6GUGWZXjur18?authuser=0&fife=s16383]]></value>
