            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZhRSn-uD4QiOgCoOVUmgTPM3iNp8J6tE6c4fltVKY5W_LMwSIHIL4y7YuslnyapXY9Zh2o2ag_ms3WkwE1ZrhuMOGWXfBQDPcYpofn0tx8qBzl6lZgsZNW9E0-DToERE5aEQsgUPcIjG7_uzxpG3PHvESRyH0T6HrcCIH7ATb4aqR57HXAtx9O4t5_vUqNS52mEQg22NeRl2J4?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZijpFHDmtP0DRmvn6T7Esgrsl8wCtYZUYPuT0BBmvJ3VpJkhBfujPToIzbkMsLt-PmsJcXGtfbLPrkJ_mexWDLG-OWAmRAXOSOL7XAOPjjZ86ja1iRAuVI5I2dzaTflcoOmctN3HtsQhtzBJfU4exC9qNKH-2m17jb8_zsSw7m9dcjZXRkLJ5XOUtkDVboszkgGra_esZjjqSI?authuser=0&fife=s16383]]></value>
