            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZisKlHjqx35rGrqoRB_3iwjm9owzbN5DQ7Lvavuown1hsByU6xSe9KJwQExk4MsCpeNz-dT08rrMGSQR-sEbTG1P0Dneyaj3m8ESCw-yjMZOGS-EFr00XjGnKCkiCHu69smmxcvjHXmLtPa5CB37pxycdKfDiXI7dDwjB_k-MT89NFJ_4JuF0oOLUBmRm6iDqCPeaVVQez7-w?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZhPb1fcaUNvsnEiXVHC0YM0Kqo0hg1LX8hp2xMt3RTUNaPyus4JvooGhAOe1Q9NUWTj6sZfxKq3ILMtLp6liC42c4lo98SWczP89uxqsMf24QBMbwE3VEtVSuHUbhYf7lTnVhB3Rc5-Tx04XnBEV6pW208DsXv2DmvH95HfMnvmW5ZZFzO0Z2xvxnyapXUhGSFPIMq1Qw5DOg?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZj-MrwxsSOip8agK4_CAt0sP6nfUS02tp0JxunvyjTLzc2Rg7-4-3vVLZFzKpfl9iOQm5tqw5u6NsIAUAVL9oSjWElFGe3RFR5laeZB8CJhaZXBYplyPnGz-gT8b0NmlgwOq_TKwq-VK19ys5a0e0xLmlpRs8QIq-57JC1brljwGVuYBvBKvOxyHMJ2oflFfOtBBlaXOAeubkQ?authuser=0&fife=s16383]]></value>
