            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZhL2wzxO2ZhjFxe6OSV5EVJvQAU-_KrT6kQ42kk-toY16v5p9WJdHzZmo0u6hTKeTyAIcX_CzlzKcmmtjqlAw3RyVaqinQ9SYw6vLap1TdLdbvD0zI9hMLmpanJweK7SFcNBSZBdQ5WNyQnMiWoVbQRsTKPx9eDuF7RBMDNkNl7kPEIHIoMUinNQoWDZSf2IYABnpP17Mk-p8o?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZihVbRsBKyNHwRSunPiGfkfp7CmDceS12MgVwInwcRBoAtaM_4eoS_INW0i8oqS4Y1vEtl85NrjzICNT1q18dvQhaMuHy10ZB5SDmvoeEfJo_FqbS6XJjnVv0VtoYTozg3P0OO-jB57c1Gj3bvpk8S7ucBT_QXlalCJgurGHKj-iEv1UG_ciCIKv6wUV4BCLvYjbju1-ctb_QI?authuser=0&fife=s16383]]></value>
