            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZj1cT_SgZv_bN-F6i_bG4CKi1-ajDcIkQ42_GufydySS6OV0aqbde5-GSfWU-J9QBUNe6x0A0FXEMJ-leCiCBlsq1N9ITx_lqJ4D5ubZKSxpeNiJtIVSKrxroFJFpvwQWykIaQd5Vrb1OdQs64wcFgkqozly8iFmHLhJP84Zc4-lKXfJ44zW4jBjAm_vT8Zz4dmgga2sG-6jU4?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZimEk2tRWZB9kkM6ZxOFn7jE9fyhIkjtJahISQZeEBkmsxUREeO68ygGGxJxF8OnHFS9tw8vHbktluNc1HRxYO3ePTzDQlV7qW2XWYwvY8mJsycfoPxjjqLFLdG2mxao9gjUhpzu3lgbMGsyQYbjbbYnMPM74R0tGe5j_00ISB0y4ueO_-XRLjBMrGAxbgCJokTcmzDeRdHWeE?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZiAw_Xx6tRJYV22LdRXCAF_46YLY_B6cB0l3O-PfTVQj3hFQ_UkGebzFGXPDKlST-WmK31o8ao5v2HHLdxHmpvva7ziScReLBGuKQhRvzdMBKlUVozDYXgM0mk54etpgNir2HohWRkC9phxeYuAZsIGyCa0dpxyHyEBRKeALxgiyZ1O4hS8BTOx5j6rwJx92bos9sZgSoN10gQ?authuser=0&fife=s16383]]></value>
