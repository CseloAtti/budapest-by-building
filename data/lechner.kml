            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZiLMx4UiyBf_Z9eHsvbnu2V9L57ZW8FVt6wsokCuBPpeqjMplP35yHeFysd41uLwqbkaAtpiTEQB0IDIlvy02IOXGmmNnjGoogApkJr0tBWyY7Y7wi24-jb4eu2QgW2e4CUpCFRoPzwPxQAJNya9C__MgWGHVAOnG0cEc6dpXAP8hMNR3rEylBZT27gG1k-7OiinSkFMM8IXVw?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZht3sUjqxOI-hqBiCHQcetb5QzDzJ2fOvWXH5DpFG4p5CVL-mqrdpRd87zc0ckIyDgRXp7g9yq8ZiB6-uVB4fBMnR--pyR8_e27UT7gDPO76mYKmQcpQhxnjb6GFkhDCdpZe2YsnYt2EH2DLGYkkJnbjj8mTtbVEpYpuYGo417VGUJP4fzogUuT-dX2YujA7nqmE7P9eBV72w?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZjVZZEGEv1aMYOgcHxBdaA_UcCMoFvhQlVrveeAiErEOWkN0TntzZD6DActJctwh1DyGok5uzkLMUI8-58Eo5fRvd03pQyUznM-AGFq7Qp3FMueaqmfwTgKrcjN2fw_E4GfZL7vED1kH656yNHZykPe1XF2EvEZTWETAIC9j4lTG05g-ZBi_9NCDOtslbMHxgDH03Myh6wU5Q?authuser=0&fife=s16383]]></value>
