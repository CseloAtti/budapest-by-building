            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZhGiIASUDp5cOtRkTdilBYoK6BCdMXN-oVHFZdXp-WfTMB5hEYmfmPXdDGvRVSqUVl5E58Gic3NaUSzI99bZuj7K0guNefls0gq5UzkNY75EsXuHc7YHGdP_YAuyxiSxd9nb4czcQQj2rfQI-ilU7EvgDWYw9Wur8W04_jpgpKdsnaEStKxvaSLfHwSLDfGK4k6Z3eAlufUIw?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZgkkeEYhqx3LpSEHkxXGyXmblZDeo1xsD6TARCGhHdFKw0rQ6EUseCrFm-nTdroZiqUItdjLbkmulHMNa_7omlm2fZuv5HEisWsSB2IqDDRlqUzjVYAXUL1OFP_SfOXznvtOXipwsgReysA2WzCrykWZUsWKvkrrMzYJMQsygEeRvX8tpWjEFCV394l1z1vmppMYPLJc2MH-w?authuser=0&fife=s16383]]></value>
