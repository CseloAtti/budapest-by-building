            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZh1OZU2hJsgB-jlP9wuiNrBIQzVtJxT5pB0mVnbRy5oz53eiOtjpoQvIGsnVTxYYIIVYTlh2MiM03JJfHfoA3uJWABcpqo3EpcboG5ysoh8ldBeRMk7v8tz0hbSBIOHblrD_DzPWmMkANVl2SSdDP7DNNuiwPEE41ptgggdgsAf77JIiym6vmuqA_droOa86ckJFAsRQ_P3PHs?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZgkDuIIUoITDjdBBkpnz_aLTCJNEz3V9rzH5VDNBXHDU6GBoEnzmmw4LvRZjygN3vt78CMwsZ6G0XugVEPgcZi2bbxKQThXCqO4JD3iTGcTVYo9Nfj3FVyP4Oq3M9NytQQBDzF8302F3XRAyUR1aUzbph7LGFGq94C71qHjCRHR9hllHwxPKgD_TANdUyebTPjZ6NLzBLPHJA?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZiDCIsj-NfW_3AaoCsZaYdw--WGx5BqcaWxgBK74kPtwjjyQt-SOgvF07642m8oHiaa3MjfycieybaoMFBUFeEKDWTbxS4PYvQC6i1OI0uG-Idkox1K0TEujw1-AsAypO38HlLkQWfL76-fKfhg7c2Sg1Wwft-7ouq_5a8nH13lhq5D0FAFf4AtyZwfcsCIxrV6lTomhvleGQ?authuser=0&fife=s16383]]></value>
