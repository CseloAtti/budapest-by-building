            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZhUHPUihiTTIoMx9z1-UK5_asW1QvFvAMdbQXCVSc5yUo3qEaIHnDBq9u8VIAX-V40AEnuWnWI5avTrRqcbmZOVn849gC1QMQcsQ0IgzVQe_ALVWk6X43Wi-ZFpfv5T_myQuZk7Dznb3iDJYVgwqjFzCctjzyo_PP_Wbt_CZa-Vd4GW8wu63QIZ3ZfwvMHr_6cFD7Kv5ejUbbc?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZjZ8DBWhFPLOnsVK51MeEvhJBqnGnnPc07842381M7oKoVBZv29loo9u_wK6k0RWL3Cqx0luSWln45HOohz1e1FXVlZPuhDWT7iNFFXYw5E74Y_bYWuDjktD-nUbKn9lyAd7RdYPYO0zqNNTx3tzjnhBWQq6ci4dWasoTN03IZ-wOibfC4OW42T1iGwgIrOETZSsEQdilopmg?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZi1ZBAldsXK1sfOiTsY_Kd1zWZix56hmdWkcETztNLYB7CXo1WF8aKLzqA5CSgRfbjT7KykeN-w003RWJMLvuRQk1adkXbhOPcd3y986mvBUKAoPp0cGaRzo3lrh7AYGdhpGMC_pVYGEP9e_Obm0t9Yx_hvd65AB-6FAi18XeGQAkd9kq7RaocYP9RdshyXkx89_VjH7yW6Qw?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZiU_KX3O24JyP-K5MfYE-vMME0q_Mfn2dCojyI1NvVzate51uRRZUJ4ZYnXwEHyVXrLlslfnRPOtcmflFHpMxkmKapxXvfO5Ezt79bDHvN2owZc0kovM9yOpzXSyUurgYb-0yvC3v3NBicCN5xkZSnY55rP8uMwiEQ_grfdLiyL9idP4qoYC9yW06EqQ6ku9LU1ivcF3dNGKQ?authuser=0&fife=s16383]]></value>
