            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZiayr5wFMa24KnJx2vYpDS1gxKgDFgrMAC-HU6KPr4l8lU3mDV7NiMlvooN5PD3_tTycsWkOU_5vJ8cD89A576ed6o5tsz0Pe57mNsw2hg_Tkr34WzCAtN5Di-6O2iZ-e5KKzApaQLjraSMDK1iiPtqDiliyrXlaMFcRslG2NZuHXQWFUA0AMg2wBGhUg1wdjM1KZ-QeDs_vw?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZi_OqFLSw3TmZqKvs-8BlaU8aW5MVPyDuV_zYB5mG7OMrearPM-094fvq4RzLMMXI16AGmukf47AOt_uxE9zSlgZPy6QFf2Qrayb93FW2Knug6Uuiyt0gZcNzdLu1Y3GIQnU3TxvZIVQqKa6_IrlAu41pgDQzLq3MGRk-xgDoNDrB417Mjk1DgwdmH4nJyVnCrIYSFs_qbxifA?authuser=0&fife=s16383]]></value>
