            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZgKLKwIIeAYWcBhP-_hF6W10fZ9jgKv-fkqsUxMxnNA1QJdvDkHnKBqg8thN6Yp7SG_5TpcHSbjePh8Rq03P1_mivoGdZA9ZKuD_9fiJTisRInQpofBcxOa8XaUttUUT06hilQ4aw8v01tv2D2uDelSsOCndlc2MQFbHp1iP15TH3iHkFlfZjTm9lIXpNKTEyW7oKrCkoBPiQ?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZhAWm355sMu0IzlQ91a9k-qgiNhLMlMXbSgVhEkHDRAgNW_PyTw6aY-4O-8xYzUpwKCQXiCY219SzPbqB0KKyglfokoaM-aYL8jv6NboeC6p7LBWVxhlA0c9R7vo41ZfWPdhmfx_iSyJFVlXjE1d8pCLg5eQBr1nCWP1QPPq0WPun_onICsy56XnYDtItFK2QT3LbvCrSJZBE0?authuser=0&fife=s16383]]></value>
