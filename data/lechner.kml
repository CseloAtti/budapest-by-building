            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZiiSW2ZMS3nNr-zeiLfBzvPhb2-Kr8KpOAGIwJOkab0TZJXVBjyPLWjCGojqhtNAMMyVkkm3YN8DAlIfG_YG1__t_XIQ_HXJ7uq7nv8Pztmf1QmmB-M7-3-3VIX6Oz2J4emRSYL7Bj3ImQ5mmBj1ucBevyCpnmacbvjXkpQH4dMlCU14da6PNhxMcmI7ogo1lZWJHEpK9UoErc?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZiqeQ5Ju9kiWTLj600Jzyj7PTbxYBQikFvXP9jzb_58gxgcixeV6teujRV7wSl8p36cHdvO9GPwTMUc9LoQn02VPk0ifCNO_dJpazZymivmjmbuxvHHoIHvX_qv7Ow9UseXtNQpDo5Y1LRaGiG9KNfCkvaLYm4NTEJoUN7TF_YD_GxfdUf3cfPf7oMSEr7DQ5KWq0RH-cfSHA?authuser=0&fife=s16383]]></value>
