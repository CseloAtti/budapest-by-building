            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZjO0OW65i2tk-TXcABZvSksdspSMub6tgZvpcA26kexzPB3QhoNntUyluDHxoCiQvCcMi7wwxBcqvAKv2fNMP5tTcp-umMRQgOrdnTZ1adPGaO2hgGUOvx7X63GVzPhYP0HpbD5SJi94vZ7CLAQsOVubklpBx3AFMFqiu3y3_q4ANNpYjGvAzN2jdsZLedfooTLGL1XCi1esA?authuser=0&fife=s16383]]></value>
