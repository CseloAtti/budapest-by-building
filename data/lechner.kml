            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZhlj3z6n4azH9WuFgpU7-257sK3ZnvrX_5sImWQ_c8WlGos3sgJ_kC7yo9ISgL1B7QoSJbl8P4SlW4es_bDETiG9-cPSKqpWjo5EHzpUiLMhMTIn-hamU9J6C4PSX5dLOBhN3htqjmFgDIhMxnZjG4Mgh5jHlftCwlUjg6n30Hf_mx7J8KZVjjc_Wty-yfZruujn97o3G8_bD0?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZgxc80vvbxRXWUL9xygypVdALlPzRvhtkWiwhSRw1V7bR58PI-CTdWFSg75ve4mAfcX0zpFoIG0mrHy8BrRxuIo9NfUDXWtly8Nwh-guWi7FIHnuoisFRzwdHsP2CT7_f3YGWUoRRCurcEi8w4XH2q5IN-SMZ7xOgOix5yqM8WGER63gYytIYebrsXoOBcq-3gMxr33WKveOA?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZg5qhwgreVNpFHO6FReQoDCqZp8bkj56uFg9diTMpPqpjg5sRegwQTW2APuLju-nOVm2TfI0kQ-OVqzVUqFGcdQ7aTfNlKxNa9sEz170oUFPO6zEwBbOPxNvgBQDXYPkBNSv2y5LxN4PzK-oUXDp56IZ8aaVHztX_bC7UF3VpEzih07wpWATV3jMIxrVi-fyAD2__qCxvcIfg?authuser=0&fife=s16383]]></value>
