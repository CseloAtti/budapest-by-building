            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZhdKiJlsXVIFI0923_ngVlvhiJ-UNvmvW8wS6n8Czv8vN3r3XWexxLc5d6ty8Oy7DCP-wjdIjtd3bMPR-ck2IjY1Y_1xznXUUInpL8COtZB9Bra0LhOI_KlP8LklHCFKD6huItPPLJeAACJTPqen7fBxzlMhjbWnfwGcsAcIyR3LhCA2xgy1Cg4aF8Ib5mGEBravOAR4HUzrQ?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZgppVjAcMJ7I8kSUU_-KWWGavVCzQ5xZynL5DpnEkritLCpJX0S6OtbxUVxT58jAcTZBV4wUBezrf8-Az36yAjLlpM36U4m6-U0BF5w0eQjO7UQ_vXZsgG3qWCDumgVOyZJixzrB0LdxfdUXLCZopoEc7JsxXuwqd4caNX0tFK8cYXy3ZlOdO3zD0vYvkUv3d7PRSWLs3-pXv4?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZh_g654hBt9mXZVF1IlTi0yTch2B_wSEHUIRsI6f08vRzq2Scr8rfQZZqKcq_BkGddmZ_knwi0_L6ZrgHjDRKOAiH59PO5vHd2KOtxSEqu1eFTCvsj-E1I4Y8Oi9tl8QbvBlLJz7QrHZrA5VUzpJcKFZGUMQBFTId4iBrYSNql3U9E9Lyns_r70KnVp-JOeDBzdphIOoM5U9w?authuser=0&fife=s16383]]></value>
