            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZgs5mnO1k_s1jopxa8gakd1f1ctfrlotsgVXaul-wzQbWVZfEuaMObWaYUU4BOb3egzcnom5ejDcbyKZeBW8g-3BWTF1Xe1lysmerr3iekFJwbvYSH4d1LUTeKUlD-CczsY6bPsF-bKMYBmeWWfbUXivEjp9Db6IvszcQK03qfdfgoG1TcwbmJxaBXG3iokHcE6_y7ibu2VQkE?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZgu5j6mDQKOq06ejh_uJvBTQPZPKo1VCfO9VDVhOs7NmuRxfsbUndhtoiMGGuGwSw7D6p6-AWKUkP73k_ahS4D99Z1RKW4egSO7W68dEUdf4CYz2qTMO62Be7x_LxVllY8OW0MbM0puPBSkoyFxjpcfGQQB7nkzXbEu70ksIPbqudyorKr4qwHtkrI0bdriN1b3aUjFgrLFTw?authuser=0&fife=s16383]]></value>
