            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZhmeGmPvC5uFWy3JmUyXIHGkDJ9AbXwhzgZuzxH7wgk9msm5Rh3d8U9Go6AsaTMy1kJT4h1xqXVwe7xDTsz7ztHtneNkrUJJQhAc8l4MAp27FEt-4zEdC_roabrSznY-GkXyO_Qh0EWzzJc4HsotonYGhmS3KzofoD46dRZdZ6o8JGmdOmuwG0KkUx_0iuLGGi6WtexuXUXQyI?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZjNdC7tfYuLSxfBUXPNP-fdTx8ORVJsyOv7-90u-vZPA73eFErWDWqItKhSIFvs6IfdO3h9zLy4xnS2EjUfcsb2xURmLA6_eUhRhs8c4sm2j2HCCHv7T3JMRO9Q5cS-PQ4BnPdZ2ZCEImxXwCRh4H7ZaxffAOIQ8hIG-rmGicacou93BIxALgW8lXx8-_ud6CGYhH7dLv8p_LM?authuser=0&fife=s16383]]></value>
