            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZi2SIc5At2Tuez3LApNnjFGSDDtOA53qb4MdCfY2PVkMFfz9t73x_WWMwv2-sj3VWBWBdoFrcLpW73iSbBQDywRnbKWLb9z7K3X_Htq8RbfejVJvVhAY86BhF7WDBUYHf4qGx2hb4S_gPrVsuGWtUMbGQfnp0RPvqAG9GIhbi7FyVI6jaYgtTj7js2kCaqb_PZa9ZeBHhqpWg?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZj1-gxb2vcZ4SmTgYD23zo5pSpnPzJMryoZ7tkOjyiBPVSQSuDj74ebdSAYBFPQVJRYq9xpRArYWEmXKae-L3PzhUqsOb5JjFwfPsZqQ8dxZSISxsVSa1Wgl0R2vPhpdiB-Id_IbrxU-riPTANBi_TANtIiSXtxnI0Yfm84QWT1NzSZwSqOHpdxbWOFe6gPsU8Kj9hZBHJmmg?authuser=0&fife=s16383]]></value>
