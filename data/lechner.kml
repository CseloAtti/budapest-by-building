            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZjxmbb38bECRxA_BLzZleLyD8GxrX7QfbyXU6eruFMFvLov3CQsQHYWLT-iCKi-4aA-4M3_n9ZYQ7CcvhIzbCiCxfnKB9ClsMqgmQor_HVtK6yCjxQvWwDeEs0MFigvRsXRbMZ2A4IdO_bzgZQ--nLr_Kkigi896bzuowmDiJVPSJ7Vy_X6Z3e9A28yZ3RXDLdYx0z4TvQSSQ?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZhf8r7V5eajy9LfL5TOdZ_dQq1jMFe1GQHghWT_AVMe6LLImi82lrlyhglkysa9FO6aaw3OyiOrVKAo8zL-fdjzikq1511V3sfi0HRUPlKImUrNs1Pik48CrPbqZAdOMNlj-tGShtZuepSOpKywjy-zOev2V67__65L4a5qv-aNdVAvGxY2gdeAlG0MQEH58AiJJX-wOkWkOQ?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZjSI-O9QdJBYcQw28cZCOPJuXAwktfwpC8hA4YDgKa-Xn3O5L6I5N1s4PkVEPjGp7pls_uPmYG0Cwctw7553T9v94XEQEeunItvzzQ5waVodhLXgXj-vm6rapcuXllE-_gsf8XJ7aa80iKjHb9urAKToFGykwMtgvgAn1rig64KI5vpLwqN9ApDQVjXsjnbttEZs3HD_2WWyQ?authuser=0&fife=s16383]]></value>
