            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZhfg3UA_hit9bAjjepIM-bEi7-P43S2RbvXC3WylAHhqyx9mdITdzQqYoaZTs2R-1JumdWeS7egrDelU5JoOEI9suyWGZhmCInJbmyeqZ4dxsPymEswDKGbBtOVFnojUjbw32ZhFrWdyOwS1CCUAb4yJG-59wo_TEGkLTcDbWeaZh684Qf0Z5PcubbXAQznaTVUHJzGYD7NtA?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZhsVjaFwq1D9Ifo5EfNIIM_m1DSfFp9LJHhyTAUwfBVc_lHsBmcvvUqC4X8b5uqEAMJBW9miS66R1UGbJeaSbAM2vtrKM5aV46zSS-7myvFlFyRiZ6Q-VFna678c0T4Gq3g0ouDDu3AtPV1mOlBYHo3lwyegqLqVGRasxSieyhj4-oAnWD94Zy2HQy57ckortL3bd2V3v0PNhU?authuser=0&fife=s16383]]></value>
