            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZhQx0-S15s01QvFRAwy3fplYvEEsUlNgC4LgtH-8Fmb16Je_TrMAikVraz4_-tKl0PgM97OsYjpKBMAMGcbFmLfXYpSRJM_ABSBUM08I43uGKTFqaLSRUJN123TNWsYwaAVO70rmpp7Q98qa8j7V6-PMaYp1B_o8zoK56Jnp_XXNo43-bGd-LlgBJFhIT13SgDfVe0-Q_LYPQ?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZgMzUbZ7mNOleZqCR2uYb85zKGBdRfxy97AdPEP1Hijcc1llXegjERAQ2pr5jcnw0_PZP0duzihFvoBfFCJ_8ah5quKoGFBoXDX4YTbaAbQQ-xMzyNBTZvbzSAq_mA3UxCzso1Npg1NdewEISuUP9c3uVyRov4RGdc4OU_vulhxU_keoVAfu3oEck17x2mlUyGEA8FEPrWXDn8?authuser=0&fife=s16383]]></value>
