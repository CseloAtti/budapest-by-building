            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZjRovIPEoFGEJXyorXerpShDpVtdIfgp8RhI49nyaU9MyERX-e5NzLdQef1mpDSzilahdA3XozXHiH39r2r17q38Fcv-ZU1ON9NfbG6m049bWy0balLWZQM6lGChhdNczBZ3YDPvcXV5-q50pDSrL3vZf4YyrgYD2y2-bf6CY1zqzQr228vKbYDrv4SuH-9uaW5RMqP40RGlg?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZjQsQBoCKWBeGuCv2Hed1i6CGeNtPNUBL2JO2Dt3LJmIjhRpp3Hio9OIgMYYs7VwCKwp_j6fkgzh2D_5ZqJKb28pgTKetIBf6Wv8KIVA85LRW1qgG89p5Q7pIKObxFu1qxnnalRuOQh3u-FSP_l9TnumIHHFBWUKVNM5ZEDSV-A5tMnqpc5YJXdB8k6dKaxyvpVV9YYXftM11M?authuser=0&fife=s16383]]></value>
