            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZjzam2T4dNgBjhLrS4HF63wacTJCQOoLS8BI-2I5r1kQDxTKgKx3VvApAgsKglh9Z3Xx_D0YBFNSqOoOC0gJmrZzhYcuOxhtdGjVd8Jxy6X47Sy3eyZMqK57wreMzGUv0F1U81BhIzkfkZXxvEUdjWYltbkycT4lnSQf9t4QR4k4Lc09PB9-JVSlK5fsUhBLSjb1GZXXfhrvuM?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZjrLXC5QoucN-C3TWg-ksnx0GDGvlgY8XsGnilNRrfrcsDOXaA01Wn7LDfDaq3h86whMoOkfcqev_G-MzRlMxeTJtdWAz0b432IJJqNio5NtEN_GBFVQFWg2NWY3ZZm-0IeU0vqRO9-1Ny6JxvHgsA5LpIW_3rRvpfUGVzthz5dRNZ_kjsc4dw9D8O9WF3spDaeAmUGRIFUqg?authuser=0&fife=s16383]]></value>
