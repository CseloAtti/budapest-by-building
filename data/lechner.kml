            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZgycEvBlfANXntAdcgm9GiwPqrC9Okxj-ZVXf6ZDuh0vD0lNzvh-o2cWmwxJeV0sHGIADjdY6EQaZm80cSqSvmgs1oP3rQGtVaNrW-j6RMtuzW5pPXecVyF6QXtA_a2F8O3Cn_sJd3mFgT4GgztpEahq96jwuJa1BFf_x1VC4GIHcWv-PLDowGwit0BP9TVCYTDTCqLeVgFEA?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZj63aAkzO3ikTqdJUZm8S-cpmQNaYZQZ5SqyKN2ZiRS4OTI5-LR_SIL1TMk5YSIlDfTH9Hu3GID3dy-uJvSz_E2PRZ1JOPb1E03LxASViZuZs89_fnrHIMJ5dSltmRE_ONdQiOizLqjUIT0K04tdpebO8ga2kt-R7cVLqY1q3F-CgAUY_kzqUWDC3vxzySXA3ZjDShOBOViqQk?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZgBPSCxWnMiFuQeW6MuLEGscdlN0Z6aPxUquHwzvlFk46VCqSSkez7yMkfkEOytFpzj5CewOi_0wZ2EEfyPb2mCHXFEN9df_YvoueV0vrED59gvMjAU2MyqprX8AlCw91khMOFq_hcV_6F18KZOYnA8JW9TYfGH_hdruQ0p28aFsZvlpyiO3Jl0Kfdb5knYdVoCKAY2OnPrpQ?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZipL5W-GrE3Ez6cAHKgJOrLTVWfyiVWnNfOSVtsW_lRHPlZ1HhBXuKxfu5TulVhKctSkMdKJcD_n_PHC9ZyYnq_cGJW4e7ObSGAc28_SiZK4g8x3-XWb3d2N98i2ldmdNxIrpcTNJaEEvvHfvEOOIbdFf254eA6CvyL92sPwoLUiRvyQOYKmEOw7FAFXONCC8EIaDyExYuZOUs?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZgvbLwnmYhRP8JsUL5HNiOQrXSizLXQFsi-U4XvVczse7cXlUetwrug_4fNHhxt50iOymMTF2gLz-es5c-9pfErtBvgJT2DMovVOnrqV66IeAA5Hs83PL12J19JRTdZU9W5XhDbFI-3nBxLjNnIrcupzJ9g8_LF_8UpOoJoF1JI0XjJirvZnH88_gYMws5LmG16aiZYRP7Facg?authuser=0&fife=s16383]]></value>
