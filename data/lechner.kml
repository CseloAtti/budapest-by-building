            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZg_RBu6mJW6dZ2cfELfmc7hhWyY1-ohipKcHgjLwprCYgjDOlvYTaYnMgvyt1WopqjCuHGq-pe69YxC_M7dMkwLO8Ab8TVD2ML-T62Rp4kalw9O_ptm5xdvZtitZYGxx7czRsmFCbwFxvGou_m2iEI4Yr3s_ZIDyuJ0R-85UMyrYiNaNRdaIaKlh6Voh8rGU2UEo9HXDRbXKFU?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZhgXbTjoMHG6DoGzTvvz5hkTFQin3mX0rXs81QzG2UnBSFn8RsCs5CZLCGuuuMAmUAXmctC36_QykE-Kr6thLtMJm281vqqBREpQZbWGxdhi15fwRV5V5xqXIEg21gz1HOv8GwL0K8lmVi5VMQnaX-3QAtUPWOlHNlRqAXkCd2DKFVDgvXodpoYKWq-SnCZ4GKDW_5z0mI6nfM?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZhqMi2HLK9R1pGbkYl_6jZSVRkir06xinRcj4bdIcGSwVvku42udXSLDdez0QKUMoc1Bqb8CM_UrJBsv6kpv1MKa4IJykDQYOjbeIEAEek1muP3C9-9YTjKjyek7BUhkSQ3ht3tW9L5mdkO_0Ah163j3k6QSl3r5o60VX9Yxxn1kWGq6PqQJ2Yy08YoOhp7dlzwHRqizNv5LQc?authuser=0&fife=s16383]]></value>
