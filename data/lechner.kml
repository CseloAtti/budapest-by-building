            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZjnBZlWy3UYq59vMF-HCyPHZy1KTGaeOm_9geciY0ANbwb0gW2Jkf5wjG_23QQxwfq_D3wbgHAqouGVw4R8rJDWB2dEgkWncQ_Y0gUZ5KMK5Luj_BKQdrsduyWRrSFI-bF0cQ969OKAq8O9INpNKyBAFFPkvBh3X4PNfyKKii_vyG7CXfn3Dz7Wk1LDAMGlTRKtAISKz7Mgo3k?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZjPKvLROeaHVx45esbaRs5DtJox3ZllJgjMw4EaD3CGVThJb_EV1KWbNaaRTXH6UmAjMhJ4JGAx9D1_fHCS7EdJXVnIH9pl2JJ35yIV4CFRqsYtini38dmxTQpuZsMEL0PbXbwohbgRJI1_UQRjANCXHsmaUpdHT2dVjTrFLlVtZRAOaUzJM85K1lwkFrujNpcn7EGCp0Lqxw?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZjvtu729Pgmn20FCjTBhdd_m612kl63WliYAr3WNVDvxtjGjhHFHoYCShsqQHglp2W1k1vZD7o1x_HN-k8_fA6hY4lICxOSvd75spguZKqaAisxsOqUK5RuTvsy7Es_mtLibU55qbtNunrsVGv2ggaXUgxJAMyV9S_bsw_c_-l55-oB7Ee2wiB3d4Gh7ThtANeCmz-FlpytbQ?authuser=0&fife=s16383]]></value>
