            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZj9Q_ExeUwSdPDd4JPCZXdMMUNZs9hz9EIa_QX-qmNAvKgAM5uYb03gKoKaFdmL3E-oyhqX4GK-pks_Z8xToZ136W_QBrvvX0KDtCCmtpy9DvHiECnIodmvGu5px2ZbqTbzp5uYF4QebETH2XjCQJp2rjHDs9YwxF3CQFW3aPsZVJ07AJi5rOwvSXTkvGJWxPffMMsEM6HXDQ?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZgKrhFoLKW9H26Xli5O0WEH5ioW9oYhkeXagXLxdzo8XbB1_Gic8h-ENSZd780Seq4KEf68XJA9522-lQXlAoy3a5RAlHvd3SiJFS59RAl-mvKGHZ0m02xcPUlEWS_fBHIxfa5XVwZIeTXb6BxFT4gTF-Wjkr0aEVIpn-OhB73q0fIQbk0mJUj6CpV9Nl3Ph7gi7HErXMvw-5w?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZiqwadrJM7Usxew7HdQdZCp-u8cGgPhUJE_gcaghZbCeY160qrFH6Shu2F3RlJeS9vWJ1DHJTP7nrmgAUuPlkl_pmqF5Y64OVItsjCmMFusFkUHiM4odABCqrsUTug65nKow9dmdkLT93Yl1cexFvGXN8DPuOViOW7GdJnvc7Fi6nyynwbwJ0PuSFCTdKwuTdiKREFfLJmNkg?authuser=0&fife=s16383]]></value>
