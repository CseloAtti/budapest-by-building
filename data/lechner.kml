            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZg9OShAorrDi-MHIFkZSpUC6WhXACNAhxsdgNom8jnWUZ23JRDqojJJpAxRCUcbZbzlOaVzSUxslkGmycESGmmyGlLW4f1O9Mv1j1i5xc0ObM3p_Corx7IeFtCAQycwgNgekz9zXSx1GEatUF6fFtfX21yT0BGelJSOOaJ3eWY3FCbwwR2J7VKU4uuE_GE-PJSpKouHltq_Lw?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZiQb-VwgkFBisU5sSS6769db5K3jb51c4myTGNmlgZ2e1LsZ0BNG6oIoIBAxbgG8Nzox65DY2xUy6TaYl_kOVxUoX-gPhpT22FXXlnrxtfPprpu4s91bRCELyu0LZAM4Zq-hIbtySbO1JJMfQYimYxb90FChco_zZ0uk6OT4b88vuDFfv5seaBpD30dvx6eMuxqFe3ZiK-0nQw?authuser=0&fife=s16383]]></value>
