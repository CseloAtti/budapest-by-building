            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZjrc1ZTiU8ljP8X79975LsZSzYWVrKRw93OSKJ6Fv45l0ZG28qg4h-h3PqWYRJUD3QABuYseeGeSzGmrSB-YeP8pltZ7Kxb6EUev63qs50P5vRbmsI7aohALFccdZbSOPebDqM_hE6z3SEcUBwK5K5ig-l28wGVhd10mJz4XVezHuq-Vg9vFhDiJpJW7Xg0fZ0AGLbf6nyeEA?authuser=0&fife=s16383]]></value>
