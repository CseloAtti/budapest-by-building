            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZiU7n17175Jo7j5jAwIs7aH8PvDk40-mAcBMvcjyf_ID-I2ABDEmD87bCOI76TzOGm6kgWg_Nfcz1e_mWNXi0WX8Y8ZTHoEW2_FkVc_NEjcvCARAoHpMoaijfk0gV-ykoWWAJbgS1XBUo5NlIbVQl3CTlxqXbDruYrVHxNOj9-u4t0OaKdPd5z8YbDn-PhNA_VEQpk2n2hBAQ4?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZigP9_8rZ6U8aQL2P422LTkxftycCgHqdKoTUuwinGBJVB8qGvfHUb_qwM_PH4wSmxyw0SllxDp9HPg7ruaUx_z_ml3ga1d1-aRztVxsDz4KtFaWrQnz0NjcMjyQmEAQ9WP8spLgM40ywQQQmHrBELGtX14zXIuedg4YL6OC0v2xcjuzvTOhDD1u-20I_llQCQ7LeGjOTNnWw?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZgfTXg27NAWUVLsjOr7_V-TW2mY4rWHOLFgR7RllhobLs7aOgx5yGjq293Xme9xLF-paFTn7rAb9QE43f1NIRrfK4ITOAFtqFU75JmQa2Otu-tXMMIJDQ2wz8y1g0bcnCDl1U3VGEVOoLlLy5jouN7y7H0iIYJtvN3ZqGdn3d1vvGl3kqarm18I6PSeHHgj-Cl6xnJOD9imWVs?authuser=0&fife=s16383]]></value>
