            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZiap7tqUS6ylOYMLUKTeZ8rWj_VGyZb98UIzHEjzLh2oxzOAh_zpSxrIjQs_WvcDhT2HOMdkJ1IZ24C3TDn8Eok5hl5pdfNoMecAfzPapYe_qL5hhdsvYkIz0H1ZSY-OR-v6DdGha4kM102O5IZfRdXnYukGHp8w-aVE3aoRONkPliNK21wV6oxxpwYSUfgdKBJWhmgXAMBeg?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZi60XqWMLp0_4eAiQ2KYN0qJDn3nH_x_d0lw5aRJwqzabIuzybd_9MC8k-75mUJLZDldeZ3nxuf0LFm8mB71LFWZF-qnswlUqmjaxuFWROHwDnIOeRtWfoMz4ZNg7L9Se1nuRKDDkuisU9cMmHBbNKxNU5LmM6F_SzWmdBW3eCST9kSB3PTJiUvf3a2xdxOVMpbJNOaxVC2eA?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZgCgaqjRnUtv5SSuTw4lLvyqNz3uc1QSPyGBW8DfHjgsH0yg1PvQ-BqbkpbKKf-TSDYuuYetTIxaWV2OL5u122mZ40CiHp-DCKPUx9qpd24GcVDTb_d7DzmrAMM8tr6i-Lgdum4MJhghDD_k68HVm-akeZHz9azdY35TVCg18HROMXaIcO5IVQ-pd_f-gfLzyco4K6B2HpTdQ?authuser=0&fife=s16383]]></value>
