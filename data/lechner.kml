            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZjmfvOZPof22RUA4pkhaL4p8eSiGeyGQNbGaH6hGNbBUvfjYD3Xzu57pTeBSFRcgPCTpipsQ3kI-sqjvJgnPZJnFc4E3J3N1WOMPzZ2vFDx3l9dc3ZYK_06EDt16FEVSufM3J0RDah90brrluE-tECxczjVyLl53UIpZutL7zSAy3MJtekqk8eqXT1ndqjifseZmxVzlSCDquA?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZhaFM3aNvl_80QkKIiQV7VmPTK2B7yc59k9e042woh8h7Ee8mpSWGv2fiJDapbDsAEtqF-6efyokH773EynP5rUxxgRZT8adqFZ7hH-ODgIPGREKAQe7HAbNXJL4pejYtxzFWFvmMgtb-gFWSaZPYTlrV9EETFkl3wBW4w5bW9C5O64ncCwGodqGCsCDRnEY7t_4sqPvoo_dJM?authuser=0&fife=s16383]]></value>
