            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZi64iPPn6FairtUx07ox4OE5KCou-Wl-vLN5hylkT6gpEW9gaputpSs8XqeuLHa1hRUUOZd6r3IXvbm6R47DvWlEYda5KZjUeKv4oL947SCF3nbv3c5kearPOmIxzrZedMOPWF_YUYRJmPfzXDGhGFvAl7qm97d-DvZzXvf4gbFHQ5PMMlCiUOo3LzUvYpFyf9NQrVANP1SGGo?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZhtO41aqiUKNBF4O2QR3PtExb6TqAGUHoioPFI9YSnG4CJvl73gSaxM-S64OMkycG5HUMCrlzCDrL2f2vUwHZUi53TPU23ktwJOoHeBGVnytIvU4S02KWJh4OlJ1_QNpcTQBC0O7P5LYhNHDVYBLeK3QnvFx-5l3_piEmW6dQzN2NZ5uxnkSg9XfLm5eJ_S4ZYCrdbLIMBRnis?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ABkJAZgnpdScY2Mj-TnNXZfD9A5kleAmmuYNLRWKKz4qRx7Gh9_wS2n2Qrcd2zMH_L9iWDzOsVZrSJHSbrtpUNnCGAi93_OVaDFTp7LGq-dwU9Fo0ZF6D65ZIXYLI7uf_4UJa2pCly_O3tf4sJIVsJ45r4hklybwq2XSpJonR222rPCbP7XJv6EqsRbptlK3DhanPoWv7uGOYTKCYkw?authuser=0&fife=s16383]]></value>
